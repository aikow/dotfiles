#!/usr/bin/env bash
#
# Usage: symlinkfb SOURCE TARGET
#
# Force create a symlink but create a backup of the target before replacing it
# with the symlink if it exists.

set -euo pipefail

if [[ $# != 2 ]]; then
  echo "usage: symlinkfb path target"
  exit 1
fi

if [[ ! -e $1 ]]; then
  echo "Error: source does not exist." >&2
  exit 1
fi
case $1 in
  /*) link_source=$1 ;;
  *) link_source=$PWD/$1 ;;
esac
target_name=$(basename -- "$2")
case $target_name in
  ''|/|.|..) echo "Error: target must name a file or directory." >&2; exit 1 ;;
esac
# Resolve the parent only: resolving the final component would follow a symlink.
target_parent=$(cd -- "$(dirname -- "$2")" && pwd -P)
link_target=$target_parent/$target_name

if [[ -e $link_target ]] && [[ $(realpath -- "$link_target") == "$(realpath -- "$link_source")" ]]; then
  exit 0
fi

backup_file=
if [[ -e $link_target || -L $link_target ]]; then
  backup_dir=$HOME/.local/backups/symlinkfb
  mkdir -p -- "$backup_dir"
  # Each replacement gets its own directory, even within the same second.
  backup_path=$(mktemp -d "$backup_dir/$(date +%Y%m%dT%H%M%S).XXXXXXXX")
  backup_file=$backup_path/$target_name
  mv -- "$link_target" "$backup_file"
fi

if ! ln -s -- "$link_source" "$link_target"; then
  if [[ -n $backup_file ]]; then
    mv -- "$backup_file" "$link_target"
  fi
  exit 1
fi
