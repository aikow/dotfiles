#!/usr/bin/env perl

use strict;
use warnings;

my $content = do { local $/; <> };
my @blocks = split(/\R\s*\R/, $content);

print "index\tspeaker\tstart\tstop\ttext\n";

foreach my $block (@blocks) {
  print "---", $block, "---";

  my ($index, $start_stop, $speaker_text) = split /^/m, $block, 4;
  chomp($index, $start_stop, $speaker_text);

  my ($start, $stop) =
    $start_stop =~ /^(\d{2}:\d{2}:\d{2}\.\d{3})\s+-->\s+(\d{2}:\d{2}:\d{2}\.\d{3})$/
    ? ($1, $2)
    : ("", "");

    # or next;

  my ($speaker, $text) = $speaker_text =~ /^([^:]+): (.*)$/
    ? ($1, $2)
    : ("", $speaker_text);

  print "$index\t$speaker\t$start\t$stop\t$text\n";
}
