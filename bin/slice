#!/usr/bin/env perl
#
# Usage: slice START [STOP] [FILE...] <file
#
# Print an inclusive, one-based range of lines. With no STOP, print START only.
# A STOP of +N ends N lines after START. Without FILE, read standard input.

use strict;
use warnings;

my $usage = "Usage: slice START [STOP] [FILE...]\n";
my $start = shift @ARGV;
die $usage unless defined $start && $start =~ /\A[0-9]+\z/
  && $start >= 1 && $start <= 2147483647;
my $stop = @ARGV ? shift @ARGV : $start;
die $usage unless $stop =~ /\A\+?[0-9]+\z/ && $stop <= 2147483647;
$stop = $start + $1 if $stop =~ /\A\+([0-9]+)\z/;
die $usage unless $stop >= $start && $stop <= 2147483647;

@ARGV = ("-") unless @ARGV;
my $line = 0;
for my $file (@ARGV) {
  my $input;
  if ($file eq "-") {
    $input = *STDIN;
  } else {
    open $input, "<", $file or die "Cannot open input: $!\n";
  }
  while (my $text = <$input>) {
    ++$line;
    print $text if $line >= $start;
    exit 0 if $line >= $stop;
  }
}
