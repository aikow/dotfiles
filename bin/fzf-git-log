#!/usr/bin/env bash

set -o pipefail

git is-repo || exit

git log \
  --date=short \
  --graph \
  --color=always \
  --format="%C(green)%C(bold)%cd %C(auto)%h%d %s (%an)%C(reset)%x09%H" \
  | awk 'index($0, "\t")' \
  | fzf \
    --ansi \
    --no-sort \
    --reverse \
    --multi \
    --bind 'ctrl-s:toggle-sort' \
    --header 'Press CTRL-S to toggle sort' \
    --delimiter="$(printf '\t')" \
    --with-nth=..-2 \
    --preview 'git show --color=always {-1}' \
  | awk -F '\t' '{print $NF}'
