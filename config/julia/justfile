init-env version="release":
  julia "+{{version}}" -e 'using Pkg; Pkg.add([ \
    "AlgebraOfGraphics", "Arrow", "BenchmarkTools", "CSV", "Chain", \
    "DataFrames", "Distributions", "GLM", "GLMakie", "GZip", "Glob", \
    "HTTP", "HypothesisTests", "JSON", "PrettyTables", "QuackIO", \
    "Revise", "StatsBase", "Tables", "UnicodePlots", "YAML", \
  ])'

install-jetls:
  julia -e 'using Pkg; Pkg.Apps.add(; url="https://github.com/aviatesk/JETLS.jl", rev="release")'

install-runic:
  julia -e 'using Pkg; Pkg.Apps.add(; url="https://github.com/fredrikekre/Runic.jl", rev="master")'

