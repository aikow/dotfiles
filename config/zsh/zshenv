# Set the dotfiles directory
export DOTFILES="$HOME/.dotfiles"
export DOTFILES_ZSH="$DOTFILES/config/zsh"
export LOCAL_CONFIG="$HOME/.local/config/zsh"

export LC_ALL=en_US.UTF-8

# Modify the path
typeset -U path
path=(
  "$HOME/.local/bin"
  "$DOTFILES/bin"
  /usr/local/bin
  $path
)

## Editor ##
export VISUAL="nvim"
export EDITOR="$VISUAL"

## Bat ##
export BAT_THEME="gruvbox-dark"

## File colors: use the terminal's ANSI palette so colors follow its theme. ##
export LS_COLORS="$(< "$DOTFILES/config/dircolors/ls_colors")"

## FZF ##
export FZF_DEFAULT_COMMAND='fd --type file --follow --hidden --exclude .git --color=always'
export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
export FZF_DEFAULT_OPTS="$(< "$DOTFILES/config/fzf/default_opts")"

## Skim ##
export SKIM_DEFAULT_COMMAND="$FZF_DEFAULT_COMMAND"
export SKIM_CTRL_T_COMMAND="$SKIM_DEFAULT_COMMAND"
export SKIM_DEFAULT_OPTIONS="$(< "$DOTFILES/config/skim/default_opts")"

## Homebrew ##
export HOMEBREW_NO_ENV_HINTS=1

## Local Environment Config ##
[[ -f $LOCAL_CONFIG/zshenv ]] && source "$LOCAL_CONFIG/zshenv"
