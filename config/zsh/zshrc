zsh_dir=$HOME/.local/share/zsh
plugin_dir=$zsh_dir/plugins

## Completions ##
# Add custom completions to fpath.
fpath=($zsh_dir/completions $DOTFILES_ZSH/functions $fpath)

# Enable the "new" completion system (compsys).
zstyle ':completion:*' use-cache
zstyle ':completion:*' cache-path $zsh_dir/zcompcache
zstyle ':completion:*' matcher-list 'm:{a-z}={A-Za-z}'
# Keep filename colors and use reverse video for the current menu selection.
zstyle ':completion:*' menu select
zstyle ':completion:*' list-colors "${(@s.:.)LS_COLORS}" 'ma=7'

zmodload zsh/complist
autoload -Uz compinit && compinit -d $zsh_dir/zcompdump
[[ $zsh_dir/zcompdump.zwc -nt $zsh_dir/zcompdump ]] || zcompile -R -- $zsh_dir/zcompdump

## Plugins ##
ZSH_AUTOSUGGEST_MANUAL_REBIND=1
source $plugin_dir/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh
source $plugin_dir/zsh-autosuggestions/zsh-autosuggestions.zsh
# https://github.com/jeffreytse/zsh-vi-mode/issues/297
ZVM_INIT_MODE=sourcing
source $plugin_dir/zsh-vi-mode/zsh-vi-mode.zsh

# Fzf integration needs to come after zsh-vi-mode
if command -v fzf &>/dev/null; then
  if [[ ! -f $plugin_dir/fzf.zsh.zwc ]]; then
    fzf --zsh >$plugin_dir/fzf.zsh
    zcompile -R -- $plugin_dir/fzf.zsh
  fi
  source $plugin_dir/fzf.zsh
fi

## Shell Options ##
# Automatically use pushd when using cd.
setopt auto_pushd
setopt pushd_ignore_dups

# Forbid '>' from truncating files.
setopt noclobber

# History related options.
setopt extended_history
setopt hist_expire_dups_first
setopt hist_ignore_all_dups
setopt hist_ignore_dups
setopt hist_ignore_space
setopt hist_no_store
setopt hist_reduce_blanks
setopt hist_save_no_dups
setopt hist_verify
setopt inc_append_history

# Increase history size.
export HISTSIZE=100000
export SAVEHIST=100000
export HISTFILE=~/.local/share/zsh/zsh_history

# Ignore commands for the history.
export HISTIGNORE="(* --help|man|man *|cd|cd -|pwd|date|exit|ls|lg|ll|lll|l|lt|eza)"

# Source personal config files.
source $DOTFILES_ZSH/config/prompt.zsh
source $DOTFILES_ZSH/config/aliases.zsh
source $DOTFILES_ZSH/config/keybindings.zsh
source $DOTFILES_ZSH/config/autols.zsh

# Load local config files.
[[ -f $LOCAL_CONFIG/zshrc ]] && source $LOCAL_CONFIG/zshrc
