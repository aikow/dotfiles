#!/usr/bin/env bash

set -eo pipefail

case $DOTBOT_OS_SHORT in
  darwin) target="$HOME/Library/Application Support/Code/User/settings.json" ;;
  linux) target="$HOME/.config/Code/User/settings.json" ;;
  *) exit 129 ;;
esac

if [[ ! -e $target && ! -L $target || ${DOTBOT_FORCE:-no} == yes ]]; then
  if [[ -d $target ]]; then
    echo "Error: settings destination is a directory." >&2
    exit 1
  fi
  mkdir -p "$(dirname "$target")"
  cp "$PWD/settings.json" "$target"
fi
